<mxCell id="c388" value="Trigger aktif di database (ekspor phpMyAdmin):&#10;• trg_peminjaman_anggota_aktif — BEFORE INSERT peminjaman:&#10;   anggota harus 'aktif' (AB-02)&#10;• trg_detail_peminjaman_validasi — BEFORE INSERT detail_peminjaman:&#10;   transaksi 'aktif'; maks. 3 item (AB-04); eksemplar 'tersedia'&#10;   dan tidak dalam pinjaman aktif lain (AB-05)&#10;• trg_detail_set_dipinjam, trg_detail_status_update,&#10;   trg_detail_perbarui_transaksi — sinkron status eksemplar/transaksi&#10;• trg_pengembalian_update_detail — AFTER INSERT pengembalian&#10;• trg_denda_hitung — BEFORE INSERT denda: jumlah_denda =&#10;   hari_terlambat × 1000 (versi di DB; DDL: × tarif_harian) (AB-07, AB-10)&#10;&#10;CHECK (dari DDL; tidak ikut tercetak di ekspor phpMyAdmin):&#10;ck_anggota_status, ck_petugas_nama, ck_buku_judul, ck_buku_tahun_terbit,&#10;ck_eksemplar_kondisi, ck_eksemplar_status, ck_peminjaman_status,&#10;ck_detail_status, ck_detail_tgl_jatuh_tempo, ck_pengembalian_kondisi,&#10;ck_denda_tarif_harian, ck_denda_jumlah_nonneg, ck_denda_status_tanggal&#10;&#10;View (ada di DB, bukan tabel dasar): v_peminjaman_aktif, v_denda_belum_bayar" style="text;html=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;fontFamily=Helvetica;fontSize=11.5;fontColor=#1F2A44;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="802" width="470" height="380" as="geometry"/></mxCell>
